{
  "name": "agent-transcript-exchange-format",
  "version": "0.1.0",
  "private": true,
  "description": "ATXF: a JSON Schema and JSONL format for exchanging coding-agent session transcripts",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "atxf": "bun packages/atxf-ts/src/cli.ts",
    "validate": "bun run atxf validate examples/*.atxf.jsonl",
    "test": "bun test",
    "check": "tsc --noEmit && bun test"
  },
  "devDependencies": {
    "@leostera/atxf": "workspace:*",
    "@leostera/feynman": "^0.12.0",
    "@types/bun": "^1.4.4",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "packages/*",
    "sites/*"
  ]
}
