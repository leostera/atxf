{
  "name": "agent-transcript-exchange-format",
  "version": "0.1.0",
  "private": true,
  "description": "ATXF: a JSON Schema and JSONL format for exchanging coding-agent session transcripts",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "bin": {
    "atxf-validate": "packages/core/src/cli.ts"
  },
  "scripts": {
    "validate": "bun packages/core/src/cli.ts examples/*.atxf.jsonl",
    "test": "bun test",
    "check": "tsc --noEmit && bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "packages/*",
    "sites/*"
  ]
}
