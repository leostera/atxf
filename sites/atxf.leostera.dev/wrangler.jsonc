{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atxf-www",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "atxf.leostera.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": { "enabled": true },
}
