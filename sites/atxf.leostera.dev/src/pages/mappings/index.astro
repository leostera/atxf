---
import { getEntry, render } from "astro:content";
import Document from "../../layouts/Document.astro";
import RfcHeader from "../../components/RfcHeader.astro";
import { REPO_URL, VERSION, lastUpdated } from "../../lib/site";

const entry = await getEntry("docs", "docs/mappings");
if (!entry) throw new Error("docs/mappings.md not found");
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2).map(({ slug, text }) => ({ slug, text }));
---

<Document
  title="Source mappings · ATXF"
  description="How Pi, Codex, Claude Code, OpenCode, Gemini CLI and ATIF session records map onto ATXF."
  current="/mappings/"
  headings={toc}
  tocTitle="Sources"
>
  <RfcHeader
    slot="header"
    designator={`ATXF/${VERSION} · Appendix A`}
    title="Mapping agents to ATXF"
    fields={[
      { label: "Status", kind: "status", value: "Draft" },
      { label: "Nature", kind: "text", value: "Informative" },
      { label: "Updated", kind: "date", value: lastUpdated("docs/mappings.md") },
      { label: "Source", kind: "link", value: "docs/mappings.md", href: `${REPO_URL}/blob/main/docs/mappings.md` },
    ]}
  />
  <Content />
</Document>
